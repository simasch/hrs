@startuml Use Cases Overview
left to right direction

actor "Guest" as guest
actor "Receptionist" as receptionist
actor "Housekeeping" as housekeeping
actor "Manager" as manager
actor "Email Service" as email <<system>>

rectangle "Hotel Reservation System" {
    usecase "UC-001\nSearch Available Rooms" as UC001
    usecase "UC-002\nReserve Room Online" as UC002
    usecase "UC-003\nSend Booking Confirmation" as UC003
    usecase "UC-004\nCancel Reservation" as UC004

    usecase "UC-005\nCheck In Guest" as UC005
    usecase "UC-006\nCheck Out Guest" as UC006
    usecase "UC-007\nGenerate Invoice" as UC007
    usecase "UC-008\nView Room Status" as UC008

    usecase "UC-009\nUpdate Room Status" as UC009

    usecase "UC-010\nGenerate Occupancy Report" as UC010

    usecase "UC-011\nSend Arrival Reminder" as UC011
}

guest --> UC001
guest --> UC002
guest --> UC004

receptionist --> UC005
receptionist --> UC006
receptionist --> UC007
receptionist --> UC008

housekeeping --> UC009

manager --> UC010

UC003 --> email
UC011 --> email

UC002 ..> UC001 : <<include>>
UC002 ..> UC003 : <<include>>
UC006 ..> UC007 : <<include>>

note right of UC011
  Triggered by the system on a schedule
  before the guest's arrival date (FR-009)
end note

@enduml
